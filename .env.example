# === App environment ===
# "production" (default) or "staging".
# When set to "staging", only emails listed in TEAM_ALLOWED_EMAILS can use the app.
APP_ENV="production"

# === Database (PostgreSQL — required for Vercel) ===
# Prisma is the primary data store (users, groups, content). Use a SEPARATE
# database for production and staging. Get these from Vercel > Storage > Neon
# Postgres after creating a database.
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"
DIRECT_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# === NextAuth ===
# Generate a secret: openssl rand -base64 32
NEXTAUTH_SECRET="your-secret-here"
# Set to your deployment URL (e.g. https://tumbanet.vercel.app for prod,
# https://staging.tumbanet.vercel.app or the Vercel preview domain for staging).
NEXTAUTH_URL="http://localhost:3000"

# === Staging gate ===
# Comma-separated list of emails allowed to access the staging deployment.
# Ignored when APP_ENV=production. Case-insensitive.
TEAM_ALLOWED_EMAILS="alice@example.com,bob@example.com"

# === Firebase (client SDK — public, exposed to the browser) ===
# Use a SEPARATE Firebase project for production and staging
# (e.g. tumbanet-production and tumbanet-staging). Copy these values from
# Firebase Console > Project Settings > Your apps > Web app SDK config.
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""

# === Firebase Admin (server-side — keep secret) ===
# Service account credentials for the SAME Firebase project as above.
# Generate via Firebase Console > Project Settings > Service Accounts.
# In FIREBASE_PRIVATE_KEY, keep newlines escaped as \n.
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""
